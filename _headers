# Cloudflare Pages 缓存头
# Service Worker 绝不能被 CDN 缓存：否则新版本 SW 无法下发，客户端会一直用旧缓存。
/sw.js
  Cache-Control: no-store, no-cache, must-revalidate

# HTML 保持回源校验，保证 SW 更新后页面引用到最新脚本
/*.html
  Cache-Control: no-cache

# JS/CSS 每次回源校验（带 ETag，未变更时只回 304，几乎零开销）。
# 此前 CF Pages 默认 max-age=14400：发布后用户浏览器最长 4 小时看不到新版本。
/js/*
  Cache-Control: no-cache
/css/*
  Cache-Control: no-cache

/manifest.json
  Cache-Control: public, max-age=3600
